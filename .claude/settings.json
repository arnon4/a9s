{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["commit"]
          },
          {
            "type": "command",
            "if": "Bash(git add *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["add"]
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["push"]
          },
          {
            "type": "command",
            "if": "Bash(zig build *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["zig"]
          },
          {
            "type": "command",
            "if": "Bash(zig build)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["zig"]
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["commit"]
          },
          {
            "type": "command",
            "if": "PowerShell(git add *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["add"]
          },
          {
            "type": "command",
            "if": "PowerShell(git push *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["push"]
          },
          {
            "type": "command",
            "if": "PowerShell(zig build *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["zig"]
          },
          {
            "type": "command",
            "if": "PowerShell(zig build)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agents.sh",
            "args": ["zig"]
          }
        ]
      }
    ]
  }
}
